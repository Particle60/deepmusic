# 离线语音音乐播放器 systemd 服务（Linux 开发板）
# 安装:
#   1. 把项目放到 /opt/voice-music-player
#   2. 修改下方 ExecStart 里的用户/路径
#   3. sudo cp deploy/voice-music-player.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now voice-music-player
# 查看日志: journalctl -u voice-music-player -f

[Unit]
Description=Voice Music Player (offline ASR + local music)
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
# 用你的实际用户；需要 ALSA/音频权限，通常加入 audio 组
User=pi
Group=audio
WorkingDirectory=/opt/voice-music-player
ExecStart=/opt/voice-music-player/.venv/bin/python /opt/voice-music-player/app/main.py --voice
# 崩溃自动重启
Restart=on-failure
RestartSec=3
# 环境变量（可选）
Environment=VMP_MUSIC_DIR=/mnt/sd/Music
Environment=PYTHONUNBUFFERED=1
# 内存/文件保护（按需）
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
